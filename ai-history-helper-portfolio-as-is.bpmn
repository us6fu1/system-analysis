<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_portfolio-business-process" targetNamespace="https://github.com/us6fu1/AI_History_Helper/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_portfolio-business-process">
    <bpmn:participant id="Teacher_Pool" name="Учитель" processRef="Teacher_Process" />
    <bpmn:participant id="System_Pool" name="AI History Helper" processRef="System_Process" />
    <bpmn:messageFlow id="M_1" sourceRef="T_Request" targetRef="S_Start" />
    <bpmn:messageFlow id="M_2" sourceRef="S_SendTest" targetRef="T_Result" />
    <bpmn:messageFlow id="M_3" sourceRef="T_Correct" targetRef="S_ReceiveCorrection" />
    <bpmn:messageFlow id="M_4" sourceRef="S_SendUpdated" targetRef="T_Updated" />
    <bpmn:messageFlow id="M_5" sourceRef="T_Export" targetRef="S_ReceiveExport" />
    <bpmn:messageFlow id="M_6" sourceRef="S_SendFile" targetRef="T_File" />
  </bpmn:collaboration>
  <bpmn:process id="Teacher_Process" isExecutable="false">
    <bpmn:startEvent id="T_Start" name="Начало" />
    <bpmn:userTask id="T_Config" name="Настроить тест" />
    <bpmn:userTask id="T_Request" name="Запустить генерацию" />
    <bpmn:intermediateCatchEvent id="T_Result" name="Тест получен">
      <bpmn:messageEventDefinition id="MessageDefinition_T_Result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Review" name="Проверить вопросы и ответы" />
    <bpmn:exclusiveGateway id="T_Accept" name="Тест готов?" />
    <bpmn:userTask id="T_Correct" name="Запросить замену вопроса" />
    <bpmn:intermediateCatchEvent id="T_Updated" name="Исправление">
      <bpmn:messageEventDefinition id="MessageDefinition_T_Updated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Export" name="Задать настройки экспорта" />
    <bpmn:intermediateCatchEvent id="T_File" name="DOCX получен">
      <bpmn:messageEventDefinition id="MessageDefinition_T_File" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="T_End" name="Готово" />
    <bpmn:sequenceFlow id="TF_1" sourceRef="T_Start" targetRef="T_Config" />
    <bpmn:sequenceFlow id="TF_2" sourceRef="T_Config" targetRef="T_Request" />
    <bpmn:sequenceFlow id="TF_3" sourceRef="T_Request" targetRef="T_Result" />
    <bpmn:sequenceFlow id="TF_4" sourceRef="T_Result" targetRef="T_Review" />
    <bpmn:sequenceFlow id="TF_8" sourceRef="T_Updated" targetRef="T_Review" />
    <bpmn:sequenceFlow id="TF_5" sourceRef="T_Review" targetRef="T_Accept" />
    <bpmn:sequenceFlow id="TF_6" name="нет" sourceRef="T_Accept" targetRef="T_Correct" />
    <bpmn:sequenceFlow id="TF_9" name="да" sourceRef="T_Accept" targetRef="T_Export" />
    <bpmn:sequenceFlow id="TF_7" sourceRef="T_Correct" targetRef="T_Updated" />
    <bpmn:sequenceFlow id="TF_10" sourceRef="T_Export" targetRef="T_File" />
    <bpmn:sequenceFlow id="TF_11" sourceRef="T_File" targetRef="T_End" />
  </bpmn:process>
  <bpmn:process id="System_Process" isExecutable="false">
    <bpmn:startEvent id="S_Start" name="Получен запрос">
      <bpmn:messageEventDefinition id="MessageDefinition_S_Start" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="S_Generate" name="Сформировать варианты теста" />
    <bpmn:serviceTask id="S_Save" name="Сохранить тест в истории" />
    <bpmn:sendTask id="S_SendTest" name="Передать тест учителю" />
    <bpmn:eventBasedGateway id="S_Wait" name="Ждать действие учителя" />
    <bpmn:receiveTask id="S_ReceiveCorrection" name="Получить запрос на замену" />
    <bpmn:serviceTask id="S_Replace" name="Заменить вопрос" />
    <bpmn:sendTask id="S_SendUpdated" name="Передать исправленный тест" />
    <bpmn:receiveTask id="S_ReceiveExport" name="Получить настройки экспорта" />
    <bpmn:serviceTask id="S_CreateDocx" name="Сформировать DOCX" />
    <bpmn:sendTask id="S_SendFile" name="Передать готовый файл" />
    <bpmn:endEvent id="S_End" name="Завершено" />
    <bpmn:sequenceFlow id="SF_1" sourceRef="S_Start" targetRef="S_Generate" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="S_Generate" targetRef="S_Save" />
    <bpmn:sequenceFlow id="SF_3" sourceRef="S_Save" targetRef="S_SendTest" />
    <bpmn:sequenceFlow id="SF_4" sourceRef="S_SendTest" targetRef="S_Wait" />
    <bpmn:sequenceFlow id="SF_8" sourceRef="S_SendUpdated" targetRef="S_Wait" />
    <bpmn:sequenceFlow id="SF_5" name="замена" sourceRef="S_Wait" targetRef="S_ReceiveCorrection" />
    <bpmn:sequenceFlow id="SF_9" name="экспорт" sourceRef="S_Wait" targetRef="S_ReceiveExport" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="S_ReceiveCorrection" targetRef="S_Replace" />
    <bpmn:sequenceFlow id="SF_7" sourceRef="S_Replace" targetRef="S_SendUpdated" />
    <bpmn:sequenceFlow id="SF_10" sourceRef="S_ReceiveExport" targetRef="S_CreateDocx" />
    <bpmn:sequenceFlow id="SF_11" sourceRef="S_CreateDocx" targetRef="S_SendFile" />
    <bpmn:sequenceFlow id="SF_12" sourceRef="S_SendFile" targetRef="S_End" />
  </bpmn:process>
